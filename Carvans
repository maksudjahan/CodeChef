#include <bits/stdc++.h>
using namespace std;

int main() {
int t;
cin>>t;
while(t--){
    int n,i;
    cin>>n;
    int a[n];
    int count=0;
    if(n>0) count=1;
    for(i=0;i<n;i++){
        cin>>a[i];
    }
    int m=a[0];
    for(i=1;i<n;i++){
        if(a[i]<=m) {
            count++;
            m=a[i];
    }}
    cout<<count<<'\n';
}
return 0;
}
